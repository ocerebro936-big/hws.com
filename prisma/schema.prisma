generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  PAID
  SUSPENDED
}

enum PaymentScope {
  NACIONAL
  INTERNACIONAL
}

enum BillingCycle {
  MONTHLY
  ONE_TIME
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  walletAddress String?  // Endereço MetaMask para payout Web3
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants       Tenant[]
}

model PackagePlan {
  id              String       @id @default(uuid())
  name            String       @unique
  price           Float
  billingCycle    BillingCycle
  commissionRate  Float
  allowCustomDomain Boolean    @default(false)
  maxProducts     Int
  description     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenants         Tenant[]
}

model Tenant {
  id                 String        @id @default(uuid())
  host               String        @unique
  customDomain       String?       @unique
  name               String
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  plan               String        @default("starter")
  packagePlanId      String?
  packagePlan        PackagePlan?  @relation(fields: [packagePlanId], references: [id])
  status             LicenseStatus @default(PAID)
  theme              String        @default("luxury")
  accumulatedBalance Float         @default(0.0)
  latitude           Float?        // Coordenadas para o motor de proximidade do feed
  longitude          Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  products           Product[]
}

model Product {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  costPrice       Float    @default(0)
  finalPrice      Float
  imageUrl        String?
  isDropshipping  Boolean  @default(false)
  sourceHost      String?
  sourceProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id                  String        @id @default(uuid())
  tenantId            String
  orderId             String
  amount              Float
  gateway             String
  scope               PaymentScope
  status              String        @default("PENDING")
  reference           String        @unique
  mpesaTransactionId  String?
  stripePaymentIntent String?
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model PendingOrder {
  id              String        @id @default(uuid())
  orderId         String        @unique
  tenantHost      String
  tenantName      String
  totalAmount     Float
  metodoEscolhido String
  scope           PaymentScope
  clientPhone     String?
  gateway         String?
  reference       String?
  status          String        @default("PENDING")
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DropshippingLink {
  id              String   @id @default(uuid())
  tenantHost      String
  sourceHost      String
  sourceProductId String
  targetProductId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantHost, sourceHost, sourceProductId])
}

model DropshippingOrder {
  id             String   @id @default(uuid())
  orderId        String   @unique
  originalAmount Float
  supplierAmount Float
  hwsFee         Float
  resellerAmount Float
  supplierHost   String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdCampaign {
  id              String   @id @default(uuid())
  clientName      String
  targetUrl       String
  imageUrl        String
  placement       String   // "FEED_TOP" | "STORE_SIDEBAR" | "FEED_GRID"
  costPerClick    Float    @default(0.50)
  budget          Float    @default(0)
  spent           Float    @default(0)
  clicks          Int      @default(0)
  impressions     Int      @default(0)
  totalImpressions Int     @default(0)
  revenueEarned   Float    @default(0.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
