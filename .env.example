# =============================================================================
# HWS (Hub World Shopping) — Variáveis de Ambiente de Produção
# Bluewhite Corporation Lda. — Todos os direitos reservados.
# =============================================================================
# ATENÇÃO: NUNCA faça commit deste ficheiro com valores reais!
# Copie para .env e preencha com as credenciais de produção.
# =============================================================================

# ==========================================
# 🖥️  Servidor
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# 💾  Base de Dados (PostgreSQL via Prisma ORM)
# ==========================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://bluewhite_admin:COLE_A_SUA_PASSWORD_AQUI@localhost:5432/hws_production_db?schema=public"

# ==========================================
# 💳  Stripe (Mercado Internacional)
# ==========================================
# Obter em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="COLOQUE_A_STRIKE_SECRET_KEY_AQUI"
# Obter em: https://dashboard.stripe.com/webhooks (criar endpoint p/ /api/v1/hws/payments/stripe/webhook)
STRIPE_WEBHOOK_SECRET="COLOQUE_O_WEBHOOK_SECRET_AQUI"

# ==========================================
# 🇲🇿  M-Pesa (Vodacom Moçambique)
# ==========================================
# API IPG (Internet Payment Gateway) — Produção
MPESA_PRODUCTION_URL="https://api.vm.co.mz/ipg/v1x/"
MPESA_SERVICE_CODE="840000"
MPESA_PUBLIC_KEY="COLE_A_SUA_MPESA_PUBLIC_KEY_AQUI"
MPESA_API_KEY="COLE_A_SUA_MPESA_API_KEY_AQUI"
MPESA_INITIATOR_ID="BLUEWHITE_INITIATOR"
MPESA_CONSUMER_KEY="COLE_A_CONSUMER_KEY_AQUI"
MPESA_CONSUMER_SECRET="COLE_O_CONSUMER_SECRET_AQUI"

# ==========================================
# 🇲🇿  e-Mola (Movitel Moçambique)
# ==========================================
EMOLA_PRODUCTION_URL="https://api.emola.movitel.co.mz/v1/payment"
EMOLA_MERCHANT_ID="EMOLA_MERCH_PRODUCTION"
EMOLA_SECRET_KEY="COLE_A_SUA_EMOLA_SECRET_KEY_AQUI"

# ==========================================
# 🌐  PayPal (Mercado Internacional)
# ==========================================
PAYPAL_CLIENT_ID="COLE_O_SEU_PAYPAL_CLIENT_ID_AQUI"
PAYPAL_CLIENT_SECRET="COLE_O_SEU_PAYPAL_CLIENT_SECRET_AQUI"
PAYPAL_MODE="live" # sandbox | live

# ==========================================
# 🏢  API de Revenda de Domínios (Namecheap)
# ==========================================
REGISTRAR_API_URL="https://api.namecheap.com/xml.response"
REGISTRAR_API_KEY="COLE_A_SUA_NAMECHEAP_API_KEY_AQUI"
REGISTRAR_USERNAME="bluewhitecorp"

# ==========================================
# 🛡️  Caddy Server (Admin API)
# ==========================================
CADDY_ADMIN_URL="http://caddy:2019"
# URL pública da aplicação (usada nos redirects Stripe)
APP_URL="https://hws.com"

# ==========================================
# 🤖  Gemini AI (Assistente Bluewhite)
# ==========================================
GEMINI_API_KEY="COLE_A_SUA_GEMINI_API_KEY_AQUI"
