{
    on_demand_tls {
        ask http://localhost:3000/api/v1/hws/domains/validate
        interval 2m
        burst 5
    }
}

*.hws.com {
    reverse_proxy localhost:3000
}

:443 {
    tls {
        on_demand
    }
    reverse_proxy localhost:3000
}

:80 {
    redir https://{host}{uri} permanent
}
