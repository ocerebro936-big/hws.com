{
    on_demand_tls {
        ask http://hws_app:3000/api/v1/hws/domains/validate
        interval 2m
        burst 5
    }
    admin off
}

(static_uploads) {
    @uploads path /uploads/*
    handle @uploads {
        root * /var/www/uploads
        file_server browse
    }
}

*.hws.com {
    import static_uploads
    reverse_proxy hws_app:3000 {
        lb_policy round_robin
        health_uri /health
        health_interval 10s
    }
}

:443 {
    tls {
        on_demand
    }
    import static_uploads
    reverse_proxy hws_app:3000 {
        lb_policy round_robin
        health_uri /health
        health_interval 10s
    }
}

:80 {
    redir https://{host}{uri} permanent
}
